<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>../../Windows/Babelstaarnet.Windows/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Windows/Babelstaarnet.Windows/Babelstaarnet.Windows.csproj" />
    <Content Include="fake_worker.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="word_engine_checks.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Shared/*.json" Link="Shared/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
