<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Babelstaarnet.ico</ApplicationIcon>
    <AssemblyName>Babelstaarnet</AssemblyName>
    <Version>0.7.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/*.ico" LogicalName="Babelstaarnet.Assets.%(Filename)%(Extension)" />
    <ProjectReference Include="../Babelstaarnet.Core/Babelstaarnet.Core.csproj" />
    <Content Include="../../Resources/LocalEngines/argos_bridge.py" Link="LocalEngines/argos_bridge.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Resources/LocalEngines/language_support.py" Link="LocalEngines/language_support.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Scripts/install-ocr-language.ps1" Link="LocalEngines/install-ocr-language.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Resources/LanguagePacks/catalog.json" Link="LocalEngines/language-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Scripts/install-language-support.ps1" Link="LocalEngines/install-language-support.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Scripts/install-local-engines.ps1" Link="LocalEngines/install-local-engines.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Resources/LocalEngines/piper_bridge.py" Link="LocalEngines/piper_bridge.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Scripts/install-neural-voice.ps1" Link="LocalEngines/install-neural-voice.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/images/logo.png" Link="logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildSharedPolicy" BeforeTargets="BeforeBuild">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../Scripts/build-shared-windows.ps1&quot; -Configuration $(Configuration)" />
  </Target>
  <ItemGroup>
    <Content Include="../../build/shared-policy/$(Configuration)/babel_policy.dll" Link="babel_policy.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
